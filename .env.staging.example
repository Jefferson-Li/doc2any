# Staging / test environment
DOC2ANY_ENV=staging
DOC2ANY_DEBUG=true
DOC2ANY_PUBLIC_LABEL=Staging

DOC2ANY_MAX_UPLOAD_MB=30
DOC2ANY_RATE_LIMIT_ENABLED=true
DOC2ANY_RATE_LIMIT_PER_MINUTE=40
DOC2ANY_RATE_LIMIT_ANALYZE_PER_MINUTE=80
DOC2ANY_FILE_TTL_SECONDS=1800
DOC2ANY_CLEANUP_INTERVAL_SECONDS=180
DOC2ANY_CLEANUP_ENABLED=true
DOC2ANY_CORS_ORIGINS=*

# Host port published by docker compose
HOST_PORT=8001
