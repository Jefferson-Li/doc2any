# Local development (optional; start.sh also works without Docker)
DOC2ANY_ENV=development
DOC2ANY_DEBUG=true
DOC2ANY_HOST=0.0.0.0
DOC2ANY_PORT=8000

# Paths (leave empty to use backend/uploads & backend/outputs)
# DOC2ANY_DATA_DIR=/absolute/path/to/data
# DOC2ANY_UPLOAD_DIR=
# DOC2ANY_OUTPUT_DIR=

DOC2ANY_MAX_UPLOAD_MB=50
DOC2ANY_RATE_LIMIT_ENABLED=true
DOC2ANY_RATE_LIMIT_PER_MINUTE=60
DOC2ANY_RATE_LIMIT_ANALYZE_PER_MINUTE=120
DOC2ANY_FILE_TTL_SECONDS=7200
DOC2ANY_CLEANUP_INTERVAL_SECONDS=300
DOC2ANY_CLEANUP_ENABLED=true
DOC2ANY_CORS_ORIGINS=*
DOC2ANY_PUBLIC_LABEL=Dev

HOST_PORT=8000
