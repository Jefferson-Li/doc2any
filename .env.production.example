# Production environment — do not commit real secrets
DOC2ANY_ENV=production
DOC2ANY_DEBUG=false
DOC2ANY_PUBLIC_LABEL=

DOC2ANY_MAX_UPLOAD_MB=50
DOC2ANY_RATE_LIMIT_ENABLED=true
DOC2ANY_RATE_LIMIT_PER_MINUTE=15
DOC2ANY_RATE_LIMIT_ANALYZE_PER_MINUTE=30
DOC2ANY_FILE_TTL_SECONDS=1800
DOC2ANY_CLEANUP_INTERVAL_SECONDS=120
DOC2ANY_CLEANUP_ENABLED=true

# Replace with your public site origin(s)
DOC2ANY_CORS_ORIGINS=https://doc2any.example.com

HOST_PORT=8000
